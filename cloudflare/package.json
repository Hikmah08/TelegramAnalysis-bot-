{
  "name": "trading-bot-cloudflare",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker and Pages deployment for multi-user ICT/SMC paper trading bot",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "test": "node --test tests/**/*.test.js",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute trading-bot-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.157.0"
  }
}
